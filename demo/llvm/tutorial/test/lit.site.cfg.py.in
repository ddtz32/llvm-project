# llvm configurations
config.llvm_tools_dir = "@LLVM_TOOLS_BINARY_DIR@"

# clang tutorial configurations
config.custom_build_dir = "@CMAKE_BINARY_DIR@"
config.custom_lib_dir = "@CMAKE_LIBRARY_OUTPUT_DIRECTORY@"
config.shared_lib_ext = "@CMAKE_SHARED_LIBRARY_SUFFIX@"

import lit.llvm
lit.llvm.initialize(lit_config, config)

lit_config.load_config(config, "@CMAKE_CURRENT_SOURCE_DIR@/lit.cfg.py")
